# AegisMesh 天穹韌網 — 環境變數範本
# 複製成 .env 後填入實際金鑰：cp .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# 自訂端點（Azure OpenAI / 代理 / 本地 vLLM）時才需要
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- AegisMesh 執行設定 ---
# LLM 不可用時是否退回決定性推理（true 讓 Demo 永遠跑得起來）
AEGIS_ALLOW_OFFLINE_LLM=true
# 稽核軌跡輸出目錄
AEGIS_AUDIT_DIR=runs
# 高風險動作是否需人工核准（Demo 建議保持 true）
AEGIS_REQUIRE_APPROVAL=true
