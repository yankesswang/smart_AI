# Factory Guardian AI — 本機環境變數範本
# 複製成 .env 後填入即可。整套 Demo 不需要金鑰也能跑（會用離線確定性敘述器）。

# --- LLM（選用）---------------------------------------------------------------
# 沒有金鑰時，Diagnosis / Impact / Verification 的敘述會退回離線確定性敘述器。
# LLM 只負責寫敘述，不參與方案排名、安全裁決與動作執行。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# 設 0 可強制要求真實 LLM（沒有金鑰就直接報錯，用來確認 Demo 真的接上了模型）
FG_ALLOW_OFFLINE_LLM=1

# --- 治理 ---------------------------------------------------------------------
# 停機 / 改變控制狀態等高風險動作是否需要人工核准（規格 §9.1）
FG_REQUIRE_APPROVAL=1

# --- 執行 ---------------------------------------------------------------------
FG_AUDIT_DIR=runs
FG_SEED=20260809
FG_TICK_SECONDS=60
