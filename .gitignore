# 本機環境變數（含 API 金鑰）—— 絕對不進版控
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# 測試與快取
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 執行產出
# 用 runs/* 而不是 runs/:目錄整個被排除時,底下的檔案就再也 ! 不回來了。
runs/*
# 例外:真 LLM B1 baseline 的量測快取要進版控 —— 離線(決賽現場沒網路)
# 也必須報得出真實 B1 的數字,而不是回頭用模擬值(見 agentgate/llm_baseline.py)。
!runs/agentgate_b1_llm.json
benchmark.json
.tmp/

# 外部公開資料集（需自行下載，見 README）
data/external/

# 編輯器 / 作業系統
.DS_Store
.idea/
.vscode/

# ppt-master 工作目錄產出（只追蹤 projects/*/notes/ 的講稿）
projects/*/analysis/
projects/*/backup*/
projects/*/exports/
projects/*/icons/
projects/*/images/
projects/*/live_preview/
projects/*/sources/
projects/*/svg_final/
projects/*/svg_output/
projects/*/validation/
projects/*/templates/

# ppt-master 在根目錄的來源快照
/sources/

# ROI 量測產出（與 benchmark.json 同性質，由 factory-guardian business 重跑）
business.json
